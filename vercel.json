{
  "regions": ["sin1"],
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.4",
      "includeFiles": "{*.php,templates/**}",
      "maxDuration": 60
    }
  },
  "routes": [
    { "src": "/(logo\\.png|app\\.js|datepicker\\.js|suguan\\.js|style\\.css)", "dest": "/$1" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}
